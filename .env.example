# Port for the single-container Express server (default 3000, Cloud Run injects PORT)
PORT=3000

# Google Cloud Project and Region for Cloud Healthcare API
GOOGLE_CLOUD_PROJECT="my-gcp-project"
GOOGLE_CLOUD_LOCATION="asia-south1"

# Location for Vertex AI Gemini models (default "global")
GEMINI_LOCATION="global"

# Active FHIR backend: "local" (in-memory + /data/fhir) or "healthcare_api" (Google Cloud Healthcare API)
FHIR_BACKEND="local"

# Cloud Healthcare API parameters (when FHIR_BACKEND=healthcare_api)
FHIR_DATASET="claimsure-dataset"
FHIR_STORE="claimsure-fhir-store"

# Fast model for comprehensive claim-readiness reasoning & tool use
REVIEW_MODEL="gemini-3.8-flash"
# Fast multimodal Flash model for scanned document & invoice extraction
EXTRACT_MODEL="gemini-3.8-flash"
